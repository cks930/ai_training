
/* =========================
   基礎設定
========================= */
:root {
    --bg-dark: #f8fafc;
    --card-bg: rgba(255, 255, 255, 0.85);
    --card-border: rgba(79, 70, 229, 0.2);
    --card-border-hover: rgba(79, 70, 229, 0.8);
    --text-main: #1e293b;
    --text-muted: #64748b;
    --neon-blue: #4f46e5;
    --neon-purple: #9333ea;
    --neon-cyan: #0284c7;
    --glow-color: rgba(79, 70, 229, 0.2);
    --search-bg: rgba(255, 255, 255, 0.9);
}

/* 深色模式 */
html[data-bs-theme="dark"] {
    --bg-dark: #070b14;
    --card-bg: rgba(15, 23, 42, 0.85);
    --card-border: rgba(56, 189, 248, 0.2);
    --card-border-hover: rgba(56, 189, 248, 0.8);
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --neon-blue: #38bdf8;
    --neon-purple: #c084fc;
    --neon-cyan: #2dd4bf;
    --glow-color: rgba(56, 189, 248, 0.25);
    --search-bg: rgba(15, 23, 42, 0.9);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 80px 20px 60px;
    background: var(--bg-dark);
    color: var(--text-main);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    transition: background 0.3s, color 0.3s;
    position: relative;
    overflow-x: hidden;
}

/* 科技網格背景 */
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background-image:
        linear-gradient(rgba(56,189,248,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(56,189,248,.035) 1px, transparent 1px);
    background-size: 40px 40px;
}

/* 背景光暈 */
body::after {
    content: "";
    position: fixed;
    width: 600px;
    height: 600px;
    left: 50%;
    top: 20%;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
        circle,
        rgba(56,189,248,.12),
        rgba(192,132,252,.08) 40%,
        transparent 70%
    );
    filter: blur(80px);
}

/* =========================
   日夜模式按鈕
========================= */
.mode-switch {
    position: fixed;
    top: 20px;
    right: 30px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 30px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    color: var(--text-main);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: 0.3s;
}

.mode-switch:hover {
    border-color: var(--neon-blue);
    box-shadow: 0 0 20px var(--glow-color);
    transform: translateY(-2px);
}

.mode-switch:focus-visible {
    outline: 3px solid var(--neon-blue);
    outline-offset: 3px;
}

/* =========================
   主內容
========================= */
.wrapper {
    width: 100%;
    max-width: 1200px;
    margin: auto;
}

.header-container {
    text-align: center;
    margin-bottom: 40px;
    animation: fadeInDown 0.8s ease-out;
}

.mytitle-01 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 800;
    margin: 0 0 12px;
    letter-spacing: 1px;
    background: linear-gradient(
        135deg,
        var(--neon-blue),
        var(--neon-purple),
        var(--neon-cyan)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    letter-spacing: 1px;
    line-height: 1.6;
}

/* =========================
   搜尋欄位
========================= */
.search-box {
    width: 100%;
    max-width: 520px;
    margin: 0 auto 50px;
    position: relative;
}

.search-input {
    width: 100%;
    padding: 16px 20px 16px 52px;
    border-radius: 30px;
    border: 1px solid var(--card-border);
    background: var(--search-bg);
    color: var(--text-main);
    font-size: 1rem;
    outline: none;
    box-shadow: 0 4px 20px rgba(0,0,0,.1);
    transition: 0.3s;
}

.search-input:focus {
    border-color: var(--neon-blue);
    box-shadow: 0 0 25px var(--glow-color);
}

.search-input::placeholder {
    color: var(--text-muted);
}

.search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
}

/* =========================
   卡片網格
========================= */
#projectList {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
}

#projectList li {
    min-width: 0;
    animation: fadeInUp 0.6s ease-out both;
}

#projectList li a {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    padding: 26px;
    border-radius: 20px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    color: var(--text-main);
    text-decoration: none;
    backdrop-filter: blur(16px);
    transition: 0.3s;
}

#projectList li a:hover {
    border-color: var(--card-border-hover);
    transform: translateY(-8px) scale(1.02);
    box-shadow:
        0 15px 35px rgba(0,0,0,.2),
        0 0 30px var(--glow-color);
}

#projectList li a:focus-visible {
    outline: 3px solid var(--neon-blue);
    outline-offset: 3px;
}

.card-top,
.card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    font-size: 1.3rem;
    color: var(--neon-blue);
    background: rgba(56,189,248,.1);
    border: 1px solid rgba(56,189,248,.2);
    transition: 0.3s;
}

#projectList li a:hover .card-icon {
    transform: rotate(8deg) scale(1.1);
}

.card-tag {
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    border: 1px solid var(--card-border);
}

.card-tag.frontend {
    background: rgba(192,132,252,.15);
    color: var(--neon-purple);
}

.card-content {
    margin: 16px 0;
}

.card-title {
    margin: 0 0 8px;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-file {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: monospace;
}

.card-bottom {
    border-top: 1px solid var(--card-border);
    padding-top: 14px;
    color: var(--neon-blue);
    font-size: 0.9rem;
    font-weight: 600;
}

.arrow-icon {
    transition: transform 0.3s;
}

#projectList li a:hover .arrow-icon {
    transform: translateX(8px);
}

.empty-message {
    margin-top: 30px;
    text-align: center;
    color: var(--text-muted);
}

[hidden] {
    display: none !important;
}

/* =========================
   動畫
========================= */
@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================
   手機版 RWD
========================= */
@media (max-width: 768px) {
    body {
        padding: 90px 16px 40px;
    }

    .mode-switch {
        top: 15px;
        right: 15px;
    }

    #projectList {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    #projectList li a {
        min-height: 200px;
    }

    .subtitle {
        font-size: 0.9rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
