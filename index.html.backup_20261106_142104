<div class="toast" id="toast" hidden role="status" aria-live="polite"></div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    /* ===== 01. 共用函式 ===== */
    const $ = id => document.getElementById(id);
    const reduced = matchMedia("(prefers-reduced-motion:reduce)");
    const finePointer = matchMedia("(hover:hover) and (pointer:fine)");
    const sleep = ms => new Promise(resolve => setTimeout(resolve,ms));

    function read(key,fallback) {
        try {return localStorage.getItem(key) || fallback}
        catch(e) {return fallback}
    }
    function save(key,value) {
        try {localStorage.setItem(key,value)} catch(e) {}
    }
    function shuffle(array) {
        const result = [...array];
        for(let i=result.length-1;i>0;i--) {
            const j=Math.floor(Math.random()*(i+1));
            [result[i],result[j]]=[result[j],result[i]];
        }
        return result;
    }
    let toastTimer;
    function toast(message) {
        $("toast").textContent=message;
        $("toast").hidden=false;
        clearTimeout(toastTimer);
        toastTimer=setTimeout(()=>$("toast").hidden=true,3000);
    }
    function celebrate() {
        if(reduced.matches)return;
        const colors=["#38bdf8","#c084fc","#facc15","#34d399","#fb7185"];
        for(let i=0;i<50;i++) {
            const piece=document.createElement("span");
            piece.className="confetti";
            piece.style.left=Math.random()*100+"vw";
            piece.style.background=colors[Math.floor(Math.random()*colors.length)];
            piece.style.animationDelay=Math.random()*.5+"s";
            document.body.appendChild(piece);
            setTimeout(()=>piece.remove(),4000);
        }
    }

    /* ===== 02. 開場 ===== */
    const closeIntro=()=>$("intro").hidden=true;
    $("skipIntro").addEventListener("click",closeIntro);
    setTimeout(closeIntro,reduced.matches?100:2200);

    /* ===== 03. 日夜模式 ===== */
    function updateTheme() {
        const dark=document.documentElement.dataset.theme==="dark";
        $("themeBtn").textContent=dark?"☀️ 淺色模式":"🌙 深色模式";
    }
    updateTheme();
    $("themeBtn").addEventListener("click",()=>{
        const next=document.documentElement.dataset.theme==="dark"?"light":"dark";
        document.documentElement.dataset.theme=next;
        save("portfolio-theme",next);
        updateTheme();
    });

    /* ===== 04. 作品與搜尋 ===== */
    const cards=[...document.querySelectorAll(".project-card")];
    const projects=cards.map(card=>({
        title:card.querySelector(".card-title").textContent.trim(),
        file:card.getAttribute("href")
    }));
    $("totalCount").textContent=projects.length;

    function searchProjects() {
        const keyword=$("searchInput").value.trim().toLowerCase();
        let count=0;
        cards.forEach(card=>{
            const match=card.textContent.toLowerCase().includes(keyword) ||
                card.getAttribute("href").toLowerCase().includes(keyword);
            card.parentElement.hidden=!match;
            if(match)count++;
        });
        $("visibleCount").textContent=count;
        $("emptyMessage").hidden=count>0;
    }
    $("searchInput").addEventListener("input",searchProjects);
    searchProjects();

    document.addEventListener("keydown",e=>{
        const active=document.activeElement;
        const typing=active.matches("input,textarea") || active.isContentEditable;
        if(e.key==="/" && !typing && !e.ctrlKey && !e.altKey && !e.metaKey) {
            e.preventDefault();
            $("searchInput").focus();
        }
        if(e.key==="Escape" && active===$("searchInput")) {
            $("searchInput").value="";
            searchProjects();
            $("searchInput").blur();
        }
    });

    /* ===== 05. 卡片 3D 與聚光燈 ===== */
    cards.forEach(card=>{
        card.addEventListener("pointermove",e=>{
            if(!finePointer.matches || reduced.matches)return;
            const rect=card.getBoundingClientRect();
            const x=(e.clientX-rect.left)/rect.width;
            const y=(e.clientY-rect.top)/rect.height;
            card.style.setProperty("--mx",x*100+"%");
            card.style.setProperty("--my",y*100+"%");
            card.style.transform=
                `perspective(900px) rotateX(${(0.5-y)*8}deg) rotateY(${(x-.5)*8}deg) translateY(-4px)`;
        });
        card.addEventListener("pointerleave",()=>card.style.transform="");
    });

    /* ===== 06. 滑鼠星光 ===== */
    let lastSpark=0;
    document.addEventListener("pointermove",e=>{
        if(!finePointer.matches || reduced.matches || Date.now()-lastSpark<65)return;
        lastSpark=Date.now();
        const spark=document.createElement("span");
        spark.className="spark";
        spark.style.left=e.clientX+"px";
        spark.style.top=e.clientY+"px";
        document.body.appendChild(spark);
        setTimeout(()=>spark.remove(),650);
    });

    /* ===== 07. 探索成就 ===== */
    let explored=[];
    try {explored=JSON.parse(read("portfolio-explored","[]"))}
    catch(e) {explored=[]}
    if(!Array.isArray(explored))explored=[];
    explored=[...new Set(explored.filter(file=>projects.some(p=>p.file===file)))];

    function updateExplore() {
        const count=explored.length;
        $("exploreBar").style.width=count/projects.length*100+"%";
        $("exploreText").textContent=`已探索 ${count} / ${projects.length} 個作品`;
        $("achievementTitle").textContent=count===8?"🏆 全站探索者":
            count>=4?"🚀 進階探索者":"🔎 初階探索者";
    }
    function recordExplore(file) {
        if(!projects.some(p=>p.file===file) || explored.includes(file))return;
        explored.push(file);
        save("portfolio-explored",JSON.stringify(explored));
        updateExplore();
        if(explored.length===projects.length) {
            toast("🏆 恭喜解鎖全站探索者！");
            celebrate();
        }
    }
    cards.forEach(card=>{
        // 不使用 preventDefault，讓連結正常開啟。
        card.addEventListener("click",()=>recordExplore(card.getAttribute("href")));
    });
    $("resetExplore").addEventListener("click",()=>{
        if(!confirm("確定要重新開始探索嗎？"))return;
        explored=[];
        save("portfolio-explored","[]");
        updateExplore();
    });
    updateExplore();

    /* ===== 08. 盲盒 ===== */
    function drawProject() {
        const p=projects[Math.floor(Math.random()*projects.length)];
        $("mysteryResult").hidden=false;
        $("mysteryTitle").textContent="🎉 "+p.title;
        $("mysteryFile").textContent=p.file;
        $("mysteryLink").href=p.file;
        toast("🎁 神祕作品已揭曉！");
    }
    $("drawBtn").addEventListener("click",drawProject);
    $("drawAgain").addEventListener("click",drawProject);
    $("mysteryLink").addEventListener("click",function(){
        recordExplore(this.getAttribute("href"));
    });

    /* ===== 09. 完整 30 題題庫 ===== */
    const questionBank=[
        {q:"HTML 主要負責網頁的哪個部分？",a:["網頁結構","動畫速度","伺服器設定","資料庫管理"],c:0,e:"HTML 建立標題、段落、圖片及連結等內容結構。"},
        {q:"CSS 主要用來控制什麼？",a:["資料庫","網頁樣式","網域名稱","伺服器硬體"],c:1,e:"CSS 控制顏色、字體、間距與排版。"},
        {q:"JavaScript 最常用來增加網頁的什麼功能？",a:["網路線路","硬碟容量","互動功能","網域註冊"],c:2,e:"JavaScript 可處理按鈕、搜尋、表單驗證等互動。"},
        {q:"HTML 中建立超連結應使用哪個標籤？",a:["<div>","<p>","<span>","<a>"],c:3,e:"a 標籤搭配 href 建立超連結。"},
        {q:"HTML 中顯示圖片常用哪個標籤？",a:["<img>","<image>","<photo>","<picturebox>"],c:0,e:"img 標籤使用 src 指定圖片來源。"},
        {q:"CSS 中設定文字顏色使用哪個屬性？",a:["background","color","font-size","border"],c:1,e:"color 設定文字顏色。"},
        {q:"CSS 中設定背景顏色使用哪個屬性？",a:["font-color","text-color","background-color","opacity"],c:2,e:"background-color 設定背景顏色。"},
        {q:"CSS 中設定字體大小使用哪個屬性？",a:["font-weight","line-height","font-family","font-size"],c:3,e:"font-size 控制文字大小。"},
        {q:"哪個 CSS 宣告能啟用 Flexbox 排版？",a:["display:flex","display:block","display:inline","display:none"],c:0,e:"display:flex 啟用 Flexbox 排版。"},
        {q:"哪個 CSS 宣告能啟用 Grid 排版？",a:["display:table","display:grid","display:inline","display:list-item"],c:1,e:"display:grid 啟用網格排版。"},
        {q:"RWD 的主要目的是什麼？",a:["增加檔案大小","限制手機使用","適應不同螢幕","取消網頁圖片"],c:2,e:"RWD 讓手機、平板及電腦都能適當顯示網頁。"},
        {q:"CSS 常用哪個規則撰寫響應式斷點？",a:["@import","@font-face","@keyframes","@media"],c:3,e:"@media 可依螢幕條件套用不同樣式。"},
        {q:"JavaScript 宣告可重新指定值的區域變數常用哪個關鍵字？",a:["let","const","static","define"],c:0,e:"let 宣告的變數可以重新賦值。"},
        {q:"哪個關鍵字不允許重新指定變數綁定？",a:["var","const","let","new"],c:1,e:"const 綁定不可重新賦值，但物件內容仍可能修改。"},
        {q:"JavaScript 的 === 主要表示什麼？",a:["指定值","只比較型別","嚴格相等比較","字串相加"],c:2,e:"=== 會比較值與型別。"},
        {q:"JavaScript 陣列的第一個索引是多少？",a:["1","-1","2","0"],c:3,e:"JavaScript 陣列索引從 0 開始。"},
        {q:"哪個方法可依 ID 取得 HTML 元素？",a:["document.getElementById()","document.createElement()","document.write()","document.querySelectorAll()"],c:0,e:"getElementById() 取得指定 ID 的元素。"},
        {q:"監聽按鈕點擊事件常用哪個方法？",a:["setAttribute()","addEventListener()","parseInt()","toUpperCase()"],c:1,e:"addEventListener('click',...) 可以監聽點擊事件。"},
        {q:"localStorage 主要用來做什麼？",a:["修改網域","建立伺服器","在瀏覽器儲存資料","壓縮圖片"],c:2,e:"localStorage 可保存日夜模式等資料。"},
        {q:"JSON.stringify() 的主要功能是什麼？",a:["刪除資料","建立 CSS","重新載入網頁","轉成 JSON 字串"],c:3,e:"JSON.stringify() 將可序列化的值轉成 JSON 字串。"},
        {q:"CSS 設定元素圓角使用哪個屬性？",a:["border-radius","border-width","outline","margin"],c:0,e:"border-radius 可設定圓角。"},
        {q:"CSS 設定元素外距使用哪個屬性？",a:["padding","margin","gap","height"],c:1,e:"margin 是外距，padding 是內距。"},
        {q:"HTML 密碼欄位常用哪個 input type？",a:["text","email","password","number"],c:2,e:"type='password' 會遮蔽輸入內容的顯示。"},
        {q:"哪個屬性可提供圖片替代文字？",a:["href","title","target","alt"],c:3,e:"alt 提供圖片替代文字，也有助於無障礙使用。"},
        {q:"Math.random() 回傳哪個範圍的數值？",a:["0 以上且小於 1","1 到 10 的整數","0 到 100 的整數","只有 0 或 1"],c:0,e:"Math.random() 回傳大於等於 0、小於 1 的偽隨機數。"},
        {q:"哪個方法可在陣列尾端加入元素？",a:["pop()","push()","shift()","slice()"],c:1,e:"push() 將元素加入陣列尾端。"},
        {q:"CSS 的 z-index 主要影響什麼？",a:["字體大小","元素寬度","堆疊順序","圖片解析度"],c:2,e:"z-index 影響適用元素的堆疊層級。"},
        {q:"哪個方法可解析 JSON 字串？",a:["JSON.stringify()","String()","Number()","JSON.parse()"],c:3,e:"JSON.parse() 解析有效的 JSON 字串。"},
        {q:"CSS 哪個屬性可控制不透明度？",a:["opacity","overflow","position","display"],c:0,e:"opacity 的 0 是透明，1 是不透明。"},
        {q:"哪個方法可取消表單預設送出行為？",a:["stopTimer()","preventDefault()","reload()","clearInterval()"],c:1,e:"在 submit 事件中使用 event.preventDefault() 可取消預設送出。"}
    ];

    /* ===== 10. 問答遊戲 ===== */
    let quizList=[],quizIndex=0,quizScore=0,quizTime=120;
    let quizTimer=null,quizAnswered=false,quizRunning=false;

    function endQuiz(timedOut=false) {
        if(!quizRunning)return;
        quizRunning=false;
        clearInterval(quizTimer);
        $("quizGame").hidden=true;
        $("quizEnd").hidden=false;
        $("finalScore").textContent=`最終得分：${quizScore} / 100`;
        $("finalTitle").textContent=quizScore===100?"🏆 前端工程師王者！":
            quizScore>=80?"🚀 前端高手！":
            quizScore>=60?"💻 前端探索者！":"🌱 前端新手冒險家！";
        $("finalMessage").textContent=timedOut?"時間到！歡迎重新挑戰。":"挑戰完成！可以再玩一次，題目會重新隨機抽選。";
        if(quizScore===100)celebrate();
    }
    function showQuestion() {
        quizAnswered=false;
        const q=quizList[quizIndex];
        $("quizNumber").textContent=`第 ${quizIndex+1} / 10 題`;
        $("quizScore").textContent=`得分：${quizScore}`;
        $("quizBar").style.width=quizIndex*10+"%";
        $("questionText").textContent=q.q;
        $("quizOptions").replaceChildren();
        $("quizFeedback").hidden=true;
        $("nextQuestion").hidden=true;

        q.a.forEach((answer,i)=>{
            const button=document.createElement("button");
            button.className="option";
            button.textContent=String.fromCharCode(65+i)+". "+answer;
            button.addEventListener("click",()=>chooseAnswer(i));
            $("quizOptions").appendChild(button);
        });
    }
    function chooseAnswer(index) {
        if(!quizRunning || quizAnswered)return;
        quizAnswered=true;
        const q=quizList[quizIndex];
        const correct=index===q.c;
        if(correct)quizScore+=10;
        $("quizScore").textContent=`得分：${quizScore}`;
        [...$("quizOptions").children].forEach((button,i)=>{
            button.disabled=true;
            if(i===q.c)button.classList.add("correct");
            else if(i===index)button.classList.add("wrong");
        });
        $("quizFeedback").textContent=(correct?"✅ 答對了！":"❌ 答錯了！")+" "+q.e;
        $("quizFeedback").hidden=false;
        $("nextQuestion").textContent=quizIndex===9?"查看成績":"下一題 →";
        $("nextQuestion").hidden=false;
    }
    function startQuiz() {
        clearInterval(quizTimer);
        quizList=shuffle(questionBank).slice(0,10);
        quizIndex=0;quizScore=0;quizTime=120;quizRunning=true;
        $("quizStart").hidden=true;
        $("quizEnd").hidden=true;
        $("quizGame").hidden=false;
        $("quizTimer").textContent="⏱️ 120 秒";
        showQuestion();
        quizTimer=setInterval(()=>{
            quizTime--;
            $("quizTimer").textContent=`⏱️ ${quizTime} 秒`;
            if(quizTime<=0)endQuiz(true);
        },1000);
    }
    $("startQuiz").addEventListener("click",startQuiz);
    $("restartQuiz").addEventListener("click",startQuiz);
    $("quitQuiz").addEventListener("click",()=>endQuiz());
    $("nextQuestion").addEventListener("click",()=>{
        if(!quizAnswered)return;
        quizIndex++;
        if(quizIndex>=10)endQuiz();
        else showQuestion();
    });

    /* ===== 11. 四合一闖關：共用狀態 ===== */
    let stage=0,labToken=0,energyTimer=null;
    const stageIds=["passwordStage","bugStage","memoryStage","energyStage"];

    function hideStages() {
        stageIds.forEach(id=>$(id).hidden=true);
        $("labWelcome").hidden=true;
        $("labComplete").hidden=true;
    }
    function updateLab() {
        $("labBar").style.width=stage/4*100+"%";
        $("labProgress").textContent=`已完成 ${stage} / 4 關`;
        for(let i=0;i<4;i++) {
            $("stageCard"+i).classList.toggle("done",i<stage);
            $("stageCard"+i).classList.toggle("active",i===stage);
            $("stageStatus"+i).textContent=i<stage?"✅ 已完成":
                i===stage?"進行中":"🔒 未解鎖";
        }
    }
    function showStage() {
        hideStages();
        updateLab();
        if(stage===4) {
            $("labComplete").hidden=false;
            save("portfolio-lab-complete","yes");
            toast("🏆 科技實驗室全部通關！");
            celebrate();
            return;
        }
        $(stageIds[stage]).hidden=false;
        if(stage===1)showBug();
        if(stage===2)prepareMemory();
        if(stage===3)prepareEnergy();
    }
    function nextStage() {
        stage++;
        labToken++;
        clearInterval(energyTimer);
        showStage();
    }
    function startLab() {
        labToken++;
        clearInterval(energyTimer);
        stage=0;bugIndex=0;
        $("passwordInput").value="";
        $("passwordFeedback").hidden=true;
        showStage();
    }
    $("startLab").addEventListener("click",startLab);
    $("restartLab").addEventListener("click",startLab);
    updateLab();

    /* ===== 12. 第一關：密碼解謎 ===== */
    $("passwordForm").addEventListener("submit",e=>{
        e.preventDefault();
        const value=$("passwordInput").value.trim();
        if(value==="3458") {
            $("passwordFeedback").hidden=false;
            $("passwordFeedback").textContent="✅ 密碼正確！入口已解鎖。";
            nextStage();
        } else {
            $("passwordFeedback").hidden=false;
            $("passwordFeedback").textContent="❌ 密碼不正確，請重新計算四個數字。";
        }
    });

    /* ===== 13. 第二關：修復 BUG ===== */
    const bugs=[
        {
            code:"<h1>歡迎來到我的網站</h2>",
            options:[
                "將結尾改成 </h1>",
                "將開頭改成 <p>",
                "刪除結尾標籤",
                "將結尾改成 </div>"
            ],
            answer:0,
            explain:"HTML 標籤開頭與結尾應正確配對。"
        },
        {
            code:"body { background-color: #ffffff",
            options:[
                "把 body 改成 html",
                "在最後補上 ; }",
                "把 background-color 改成 color",
                "刪除大括號"
            ],
            answer:1,
            explain:"這段 CSS 缺少宣告結束與規則區塊的結尾。"
        },
        {
            code:"const button = document.getElementById('start');\nbutton.addEventListener('clik', run);",
            options:[
                "把 const 改成 let",
                "把 run 改成字串",
                "把 clik 改成 click",
                "把 getElementById 改成 alert"
            ],
            answer:2,
            explain:"JavaScript 的點擊事件名稱是 click。"
        }
    ];
    let bugIndex=0,bugAnswered=false;

    function showBug() {
        bugAnswered=false;
        const bug=bugs[bugIndex];
        $("bugCount").textContent=`BUG ${bugIndex+1} / ${bugs.length}`;
        $("bugCode").textContent=bug.code;
        $("bugOptions").replaceChildren();
        $("bugFeedback").hidden=true;
        $("nextBug").hidden=true;
        bug.options.forEach((option,i)=>{
            const button=document.createElement("button");
            button.className="option";
            button.textContent=option;
            button.addEventListener("click",()=>answerBug(i));
            $("bugOptions").appendChild(button);
        });
    }
    function answerBug(index) {
        if(bugAnswered)return;
        bugAnswered=true;
        const bug=bugs[bugIndex];
        const correct=index===bug.answer;
        [...$("bugOptions").children].forEach((button,i)=>{
            button.disabled=true;
            if(i===bug.answer)button.classList.add("correct");
            else if(i===index)button.classList.add("wrong");
        });
        $("bugFeedback").hidden=false;
        $("bugFeedback").textContent=(correct?"✅ 修復成功！":"❌ 修復失敗！")+" "+bug.explain;
        if(correct) {
            $("nextBug").hidden=false;
            $("nextBug").textContent=bugIndex===bugs.length-1?"完成 BUG 關卡":"下一個 BUG →";
        } else {
            $("nextBug").hidden=false;
            $("nextBug").textContent="重新挑戰這題";
        }
        $("nextBug").dataset.correct=String(correct);
    }
    $("nextBug").addEventListener("click",()=>{
        if($("nextBug").dataset.correct!=="true") {
            showBug();
            return;
        }
        bugIndex++;
        if(bugIndex>=bugs.length) {
            bugIndex=0;
            nextStage();
        } else showBug();
    });

    /* ===== 14. 第三關：記憶晶片 ===== */
    const symbols=["◆","●","▲","■"];
    let memorySequence=[],memoryInput=[],memoryRound=0;
    let memoryReady=false;

    function prepareMemory() {
        memoryRound=0;
        memorySequence=[];
        memoryReady=false;
        $("memoryRound").textContent="完成 3 回合即可通關";
        $("memoryStatus").textContent="按下開始，觀察發亮的晶片。";
        $("startMemory").hidden=false;
        $("startMemory").textContent="開始記憶挑戰";
        buildMemoryButtons();
    }
    function buildMemoryButtons() {
        $("memoryGrid").replaceChildren();
        symbols.forEach((symbol,i)=>{
            const button=document.createElement("button");
            button.className="memory-btn";
            button.textContent=symbol;
            button.type="button";
            button.disabled=!memoryReady;
            button.addEventListener("click",()=>memoryClick(i));
            $("memoryGrid").appendChild(button);
        });
    }
    async function playMemory() {
        const token=++labToken;
        memoryReady=false;
        memoryInput=[];
        $("startMemory").hidden=true;
        $("memoryRound").textContent=`第 ${memoryRound} / 3 回合`;
        $("memoryStatus").textContent="請觀察亮起順序...";
        buildMemoryButtons();
        await sleep(500);
        if(token!==labToken || stage!==2)return;

        for(const index of memorySequence) {
            const button=$("memoryGrid").children[index];
            button.classList.add("flash");
            await sleep(650);
            if(token!==labToken || stage!==2)return;
            button.classList.remove("flash");
            await sleep(250);
            if(token!==labToken || stage!==2)return;
        }
        memoryReady=true;
        $("memoryStatus").textContent="現在依照剛才順序點擊晶片！";
        [...$("memoryGrid").children].forEach(b=>b.disabled=false);
    }
    function newMemoryRound() {
        memoryRound++;
        memorySequence.push(Math.floor(Math.random()*4));
        playMemory();
    }
    $("startMemory").addEventListener("click",()=>{
        memoryRound=0;
        memorySequence=[];
        newMemoryRound();
    });
    function memoryClick(index) {
        if(!memoryReady)return;
        memoryInput.push(index);
        if(index!==memorySequence[memoryInput.length-1]) {
            memoryReady=false;
            $("memoryStatus").textContent="❌ 順序錯誤！請重新挑戰。";
            $("startMemory").hidden=false;
            $("startMemory").textContent="重新開始記憶挑戰";
            [...$("memoryGrid").children].forEach(b=>b.disabled=true);
            return;
        }
        if(memoryInput.length===memorySequence.length) {
            memoryReady=false;
            [...$("memoryGrid").children].forEach(b=>b.disabled=true);
            if(memoryRound===3) {
                $("memoryStatus").textContent="✅ 記憶晶片修復完成！";
                nextStage();
            } else {
                $("memoryStatus").textContent="✅ 本回合成功！準備下一回合...";
                const token=labToken;
                setTimeout(()=>{
                    if(token===labToken && stage===2)newMemoryRound();
                },900);
            }
        }
    }

    /* ===== 15. 第四關：能量核心 ===== */
    let energyNext=1,energySeconds=30,energyRunning=false;

    function prepareEnergy() {
        clearInterval(energyTimer);
        energyRunning=false;
        energyNext=1;
        energySeconds=30;
        $("energyCount").textContent="已啟動 0 / 9";
        $("energyTimer").textContent="剩餘 30 秒";
        $("energyStatus").textContent="準備好後按下啟動挑戰。";
        $("startEnergy").hidden=false;
        $("startEnergy").textContent="⚡ 啟動挑戰";
        $("energyGrid").replaceChildren();
    }
    function startEnergy() {
        clearInterval(energyTimer);
        energyNext=1;
        energySeconds=30;
        energyRunning=true;
        $("energyCount").textContent="已啟動 0 / 9";
        $("energyTimer").textContent="剩餘 30 秒";
        $("energyStatus").textContent="請依照 1 到 9 的順序點擊！";
        $("startEnergy").hidden=true;
        $("energyGrid").replaceChildren();

        shuffle([1,2,3,4,5,6,7,8,9]).forEach(number=>{
            const button=document.createElement("button");
            button.className="energy-btn";
            button.textContent=number;
            button.addEventListener("click",()=>energyClick(number,button));
            $("energyGrid").appendChild(button);
        });
        energyTimer=setInterval(()=>{
            energySeconds--;
            $("energyTimer").textContent=`剩餘 ${energySeconds} 秒`;
            if(energySeconds<=0) {
                clearInterval(energyTimer);
                energyRunning=false;
                $("energyStatus").textContent="⏰ 時間到！請重新挑戰。";
                $("startEnergy").hidden=false;
                $("startEnergy").textContent="重新挑戰";
                [...$("energyGrid").children].forEach(b=>b.disabled=true);
            }
        },1000);
    }
    function energyClick(number,button) {
        if(!energyRunning)return;
        if(number!==energyNext) {
            button.classList.add("error");
            setTimeout(()=>button.classList.remove("error"),350);
            $("energyStatus").textContent=`❌ 順序錯誤，下一個應該點 ${energyNext}`;
            return;
        }
        button.classList.add("active");
        button.disabled=true;
        energyNext++;
        $("energyCount").textContent=`已啟動 ${energyNext-1} / 9`;
        $("energyStatus").textContent="✅ 能量節點啟動成功！";
        if(energyNext===10) {
            clearInterval(energyTimer);
            energyRunning=false;
            nextStage();
        }
    }
    $("startEnergy").addEventListener("click",startEnergy);

    /* ===== 16. 標題三連點彩蛋 ===== */
    let titleClicks=0,lastTitleClick=0;
    $("mainTitle").addEventListener("click",()=>{
        const now=Date.now();
        if(now-lastTitleClick>1200)titleClicks=0;
        titleClicks++;
        lastTitleClick=now;
        if(titleClicks>=3) {
            titleClicks=0;
            toast("🎉 恭喜發現隱藏彩蛋！");
            celebrate();
        }
    });

});
</script>
